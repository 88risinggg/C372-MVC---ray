<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Login - Grow Mart</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial/navbar", { brandHref: "/", navLinks: [
    { href: "/register", label: "Register" },
    { href: "/login", label: "Login", active: true }
  ] }) %>

  <!-- Login Form -->
  <div class="container page-shell auth-shell">
    <div class="auth-split reveal">
      <div class="auth-panel">
        <h2>Welcome back</h2>
        <p>Sign in to keep shopping fresh picks, manage your wallet, and track deliveries.</p>
        <div class="hero-steps">
          <div class="hero-step">
            <span>1</span>
            <div>
              <h3>Shop smarter</h3>
              <p>Curated weekly specials.</p>
            </div>
          </div>
          <div class="hero-step">
            <span>2</span>
            <div>
              <h3>Pay your way</h3>
              <p>Wallet, card, or QR.</p>
            </div>
          </div>
          <div class="hero-step">
            <span>3</span>
            <div>
              <h3>Track orders</h3>
              <p>Live updates every step.</p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="page-header page-header--center mb-4">
          <p class="page-kicker">Account</p>
          <h1 class="page-title">Sign in</h1>
          <p class="page-subtitle">Access your Grow Mart account.</p>
        </div>

        <!-- Error Messages -->
        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger">
            <% errors.forEach(err => { %>
              <p class="mb-0"><%= err %></p>
            <% }) %>
          </div>
        <% } %>

        <!-- Success Messages -->
        <% if (messages && messages.length > 0) { %>
          <div class="alert alert-success">
            <% messages.forEach(msg => { %>
              <p class="mb-0"><%= msg %></p>
            <% }) %>
          </div>
        <% } %>

        <form action="/login" method="POST" class="form-box">

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="you@example.com" 
          required
        />
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          required
        />
      </div>

      <!-- Login Button -->
      <button type="submit" class="btn btn-primary w-100">
        Login
      </button>

      <!-- Extra Link -->
      <p class="text-center mt-3">
        Don't have an account?
        <a href="/register">Register here</a>
      </p>

        </form>
      </div>

  </div>

<script src="/js/site.js"></script>
</body>
</html>



