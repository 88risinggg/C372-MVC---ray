<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <title>Order <%= order.id %></title>
</head>
<body class="page">
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/shopping">Shop</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/orders">My Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <p class="text-muted small mb-0">Order</p>
        <p class="fw-semibold mb-0">#<%= order.id %></p>
      </div>
      <a href="/orders" class="btn btn-outline-primary btn-sm">Back to Orders</a>
    </div>

    <% if (errors && errors.length) { %>
      <div class="alert alert-warning"><%= errors[0] %></div>
    <% } %>

    <div class="card glass mb-3">
      <div class="card-body d-flex justify-content-between flex-wrap gap-3">
        <div>
          <p class="text-muted small mb-1">Placed on</p>
          <p class="fw-semibold mb-0"><%= order.created_at ? new Date(order.created_at).toLocaleString() : '—' %></p>
        </div>
        <div>
          <p class="text-muted small mb-1">Total</p>
          <p class="fw-bold h5 mb-0">$<%= Number(order.total || 0).toFixed(2) %></p>
        </div>
        <div>
          <p class="text-muted small mb-1">Status</p>
          <span class="badge text-bg-success">Paid</span>
        </div>
      </div>
    </div>

    <div class="card glass">
      <div class="card-body">
        <h3 class="h5 mb-3">Items</h3>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Product</th>
                <th width="120">Price</th>
                <th width="120">Quantity</th>
                <th width="140">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% for (let i = 0; i < items.length; i++) { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <img src="/images/<%= items[i].image %>" width="70" class="rounded me-3 shadow-sm" alt="<%= items[i].productName %>">
                      <div class="fw-semibold"><%= items[i].productName %></div>
                    </div>
                  </td>
                  <td>$<%= Number(items[i].price || 0).toFixed(2) %></td>
                  <td><%= items[i].quantity %></td>
                  <td>$<%= (Number(items[i].price || 0) * items[i].quantity).toFixed(2) %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

