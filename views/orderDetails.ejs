<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order #<%= order.id %> - Grow Mart</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
  <%- include("partial/navbar", { 
  user, 
  brandHref: "/shopping", 
  navLinks: [
    { href: "/shopping", label: "Shop" },
    { href: "/wallet", label: "Wallet" },
    { href: "/orders", label: "My Orders" }
  ] 
}) %>


<div class="container page-shell">
  <div class="page-header reveal">
    <div>
      <p class="page-kicker">Order</p>
      <h1 class="page-title">Order #<%= order.id %></h1>
      <p class="page-subtitle">Details, totals, and items for this order.</p>
      <div class="page-meta mt-2">
        <span class="meta-pill">Total <span class="fw-semibold">$<%= Number(order.total || 0).toFixed(2) %></span></span>
        <span class="meta-pill">Payment <span class="fw-semibold"><%= order.payment_method || "Unknown" %></span></span>
      </div>
    </div>
    <div class="page-actions">
      <a href="/orders" class="btn btn-outline-primary">Back to Orders</a>
    </div>
  </div>

  <!-- Error -->
  <% if (errors && errors.length) { %>
      <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>
  <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success[0] %></div>
  <% } %>


  <!-- ORDER INFO CARD -->
  <div class="card glass mb-4 reveal">
    <div class="card-body row g-3">

      <div class="col-md-3">
        <p class="text-muted small mb-1">Placed On</p>
        <p class="fw-semibold mb-0"><%= new Date(order.created_at).toLocaleString() %></p>
      </div>

      <div class="col-md-3">
        <p class="text-muted small mb-1">Total</p>
        <p class="fw-bold h5 mb-0">$<%= Number(order.total || 0).toFixed(2) %></p>
      </div>

      <div class="col-md-3">
        <p class="text-muted small mb-1">Payment Method</p>
        <p class="fw-semibold mb-0"><%= order.payment_method || "Unknown" %></p>
      </div>

      <div class="col-md-3">
        <p class="text-muted small mb-1">Order Status</p>
        <span class="
          status-badge
          <%= order.orderStatus === 'Completed' ? 'status-completed' : 
              (order.orderStatus === 'Out for delivery' || order.orderStatus === 'Delivering') ? 'status-delivering' :
              'status-preparing' %>">
          <%= order.orderStatus || "Preparing" %>
        </span>
      </div>

      <% const refundStatus = order.refund_status || "Not refunded"; %>

      <div class="col-md-3">
        <p class="text-muted small mb-1">Refund Status</p>
        <span class="
          status-badge
          <%= refundStatus === 'Approved' ? 'status-completed' :
              refundStatus === 'Pending' ? 'status-pending' :
              refundStatus === 'Refunded' ? 'status-danger' :
              refundStatus === 'Rejected' ? 'status-danger' :
              'status-pending' %>">
          <%= refundStatus %>
        </span>
      </div>

    </div>
  </div>


  <% const subtotal = (items || []).reduce((sum, item) => sum + (Number(item.price) || 0) * (Number(item.quantity) || 0), 0); %>
  <% const deliveryFee = subtotal > 50 ? 0 : 2; %>
  <% const taxable = subtotal + deliveryFee; %>
  <% const gst = Math.round(taxable * 0.09 * 100) / 100; %>
  <% const computedTotal = Math.round((taxable + gst) * 100) / 100; %>

  <div class="row g-4">
    <!-- ORDER ITEMS CARD -->
    <div class="col-lg-8">
      <div class="card glass reveal h-100">
        <div class="card-body">

          <h3 class="h5 fw-bold mb-3">Items</h3>

          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Product</th>
                  <th width="120">Price</th>
                  <th width="120">Qty</th>
                  <th width="140">Subtotal</th>
                </tr>
              </thead>

              <tbody>
                <% items.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <img src="/images/<%= item.image %>" width="70"
                           class="rounded shadow-sm me-3"
                           alt="<%= item.productName %>">
                      <div class="fw-semibold"><%= item.productName %></div>
                    </div>
                  </td>

                  <td>$<%= Number(item.price).toFixed(2) %></td>
                  <td><%= item.quantity %></td>
                  <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </div>

    <!-- INVOICE SUMMARY -->
    <div class="col-lg-4">
      <div class="card glass reveal h-100">
        <div class="card-body">
          <h3 class="h5 fw-bold mb-3">Invoice summary</h3>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Items subtotal</span>
            <span class="fw-semibold">$<%= subtotal.toFixed(2) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Delivery fee</span>
            <span class="fw-semibold">
              <% if (deliveryFee === 0) { %>
                <span class="text-success">Free</span>
              <% } else { %>
                $<%= deliveryFee.toFixed(2) %>
              <% } %>
            </span>
          </div>
          <div class="d-flex justify-content-between mb-3">
            <span class="text-muted">GST (9%)</span>
            <span class="fw-semibold">$<%= gst.toFixed(2) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold">Total</span>
            <span class="h5 fw-bold mb-0">$<%= computedTotal.toFixed(2) %></span>
          </div>
          <p class="text-muted small mb-3">Charged total: $<%= Number(order.total || 0).toFixed(2) %></p>

          <% if (refundStatus === "Pending") { %>
            <div class="alert alert-warning small mb-3">Refund request submitted. Approval may take 5-10 working days.</div>
          <% } else if (refundStatus === "Approved") { %>
            <div class="alert alert-success small mb-3">Refund approved. Please wait 3-5 working days.</div>
          <% } else if (refundStatus === "Rejected") { %>
            <div class="alert alert-danger small mb-3">Refund request rejected.</div>
          <% } else if (refundStatus === "Refunded") { %>
            <div class="alert alert-success small mb-3">Refund completed.</div>
          <% } %>

          <div class="d-grid gap-2">
            <a href="/shopping" class="btn btn-outline-primary">Continue Shopping</a>
            <a href="/orders" class="btn btn-primary">Back to Orders</a>
            <% if (refundStatus === "Not refunded") { %>
              <form method="POST" action="/orders/<%= order.id %>/refund-request">
                <button type="submit" class="btn btn-outline-danger w-100">Request refund</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/site.js"></script>
</body>
</html>


