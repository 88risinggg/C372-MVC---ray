<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Supermarket App</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

  <style>
    .hero-title { animation: fadeInDown 0.9s ease; }
    .hero-subtitle { animation: fadeIn 1.4s ease; }
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-25px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body class="page">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">Supermarket App</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="collapsibleNavbar">
      <ul class="navbar-nav ms-auto">
        <% if (!user) { %>
          <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO -->
<div class="container py-4">
  <div class="text-center mb-4">
    <h1 class="hero-title fw-bold">Welcome to Supermarket App 🛒</h1>
    <p class="hero-subtitle text-muted">Fresh deals, fast checkout, clean UI.</p>
  </div>

  <!-- CAROUSEL -->
  <div id="heroCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/images/banner1.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner2.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner3.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
    </div>
  </div>

  <!-- FEATURED ITEMS TITLE -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="fw-bold">Featured Items</h3>
    <a href="/shopping" class="btn btn-primary btn-sm">View All</a>
  </div>

  <!-- FEATURED GRID -->
  <div class="row g-4">
    <% products.forEach(p => { %>
      <div class="col-6 col-md-3">
        <div class="card product-card shadow-sm">
          <img src="/images/<%= p.image %>" class="card-img-top" style="height: 150px; object-fit: cover;">
          <div class="card-body">
            <h6 class="fw-semibold"><%= p.productName %></h6>
            <p class="small text-muted mb-1">Category: <%= p.category %></p>
            <p class="fw-bold">$<%= p.price.toFixed(2) %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
