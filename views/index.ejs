<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Grow Mart</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/", 
  navLinks: (user && user.role !== "admin") ? [{ href: "/shopping", label: "Shop" }] : undefined 
}) %>

<!-- HERO -->
<div class="container py-4">
  <div class="hero mb-4">
    <h1 class="hero-title">Welcome to Grow Mart</h1>
    <p class="hero-subtitle">Bright produce, fair prices, fast checkout.</p>
    <div class="d-flex gap-2 flex-wrap mt-3">
      <a href="/shopping" class="btn btn-primary btn-sm">Start shopping</a>
      <a href="/orders" class="btn btn-light btn-sm">My orders</a>
    </div>
  </div>

  <!-- CAROUSEL -->
  <div id="heroCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/images/banner1.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner2.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner3.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
    </div>
  </div>

  <!-- FEATURED ITEMS -->
  <div class="section-heading">
    <div>
      <div class="section-title">Featured Items</div>
      <div class="section-subtitle">Hand-picked picks for you</div>
    </div>
    <a href="/shopping" class="btn btn-outline-primary btn-sm">View All</a>
  </div>

  <!-- FEATURED GRID -->
  <div class="row g-4">
    <% products.forEach(p => { %>
      <div class="col-6 col-md-3">
        <div class="card product-card shadow-sm">

          <img src="/images/<%= p.image %>" class="card-img-top" style="height: 150px; object-fit: cover;">

          <div class="card-body d-flex flex-column">
            <h6 class="fw-semibold"><%= p.productName %></h6>
            <p class="small text-muted mb-1">Category: <%= p.category %></p>
            <% const hasDiscount = p.discount && p.discount > 0; %>
            <% const finalPrice = hasDiscount ? p.price * (1 - p.discount / 100) : p.price; %>
            <p class="fw-bold mb-1">$<%= finalPrice.toFixed(2) %></p>
            <% if (hasDiscount) { %>
              <p class="text-muted small mb-2 text-decoration-line-through">$<%= p.price.toFixed(2) %></p>
              <span class="badge bg-danger">-<%= p.discount %>%</span>
            <% } %>

            <!-- ADD TO CART BUTTON -->
            <% if (!user) { %>
              <!-- Show login prompt -->
              <button class="btn btn-primary w-100"
                      onclick="loginFirst()">
                Add to Cart
              </button>

            <% } else { %>
              <!-- Actual Add-to-Cart -->
              <form action="/add-to-cart/<%= p.id %>" method="POST">
                <input type="hidden" name="quantity" value="1">
                <button class="btn btn-primary w-100" type="submit">Add to Cart</button>
              </form>
            <% } %>

          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
function loginFirst() {
  Swal.fire({
    title: "Please log in",
    text: "You need to be logged in to add items to your cart.",
    icon: "info",
    confirmButtonText: "Go to Login",
    confirmButtonColor: "#1976d2",
  }).then(() => {
    window.location.href = "/login";
  });
}
</script>

</body>
</html>
