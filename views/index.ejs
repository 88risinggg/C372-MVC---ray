<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Supermarket App</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <% if (!user) { %>
            <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
            <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>

          <% } else { %>
            <% if (user.role === "admin") { %>
              <li class="nav-item"><a class="nav-link" href="/inventory">Inventory</a></li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>

          <% } %>

        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Carousel -->
  <div id="heroCarousel" class="carousel slide mt-3" data-bs-ride="carousel">
    <div class="carousel-inner rounded shadow">

      <div class="carousel-item active">
        <img src="/images/banner1.jpg" class="d-block w-100" style="height:350px; object-fit:cover;">
      </div>

      <div class="carousel-item">
        <img src="/images/banner2.jpg" class="d-block w-100" style="height:350px; object-fit:cover;">
      </div>

      <div class="carousel-item">
        <img src="/images/banner3.jpg" class="d-block w-100" style="height:350px; object-fit:cover;">
      </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>

  <!-- Welcome Section -->
  <section class="container text-center mt-4">
    <% if (user) { %>
      <h2 class="fw-bold mb-2">Welcome back, <%= user.username %> 👋</h2>
      <p class="text-muted">What would you like to explore today?</p>
    <% } else { %>
      <h2 class="fw-bold mb-2">Welcome to the Supermarket App 🛒</h2>
      <p class="text-muted">Login to explore our products.</p>
    <% } %>
  </section>

  <!-- Search Bar -->
  <section class="container mt-4">
    <div class="input-group shadow-sm">
      <span class="input-group-text bg-white border-end-0">
        🔍
      </span>
      <input 
        id="searchInput"
        type="text"
        class="form-control border-start-0"
        placeholder="Search for products..."
        onkeyup="filterProducts()">
    </div>
  </section>

  <!-- Categories Section -->
  <section class="container mt-4">
    <h4 class="fw-semibold mb-3">Shop by Category</h4>

    <div class="row g-3">
      <% const categories = ["General", "Fruits", "Vegetables", "Snacks", "Drinks", "Household"]; %>

      <% categories.forEach(category => { %>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="glass text-center py-3 category-tile" onclick="filterCategory('<%= category %>')">
            <strong><%= category %></strong>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="container mt-5">
    <h4 class="fw-semibold mb-3">Featured Products</h4>

    <div id="productContainer" class="row g-4">
      <% if (products && products.length) { %>
        <% products.forEach(p => { %>
          <div class="col-6 col-md-4 col-lg-3 product-item" data-name="<%= p.productName.toLowerCase() %>">
            <div class="card product-card h-100 shadow-sm">
              <img src="/images/<%= p.image %>" class="card-img-top" style="height:160px; object-fit:cover;">

              <div class="card-body">
                <h5 class="card-title"><%= p.productName %></h5>
                <p class="fw-bold">$<%= p.price.toFixed(2) %></p>

                <a href="/product/<%= p.id %>" class="btn btn-primary w-100">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No products yet.</p>
      <% } %>
    </div>
  </section>

  <!-- Search Script -->
  <script>
    function filterProducts() {
      const query = document.getElementById("searchInput").value.toLowerCase();
      const items = document.querySelectorAll(".product-item");

      items.forEach(item => {
        const name = item.dataset.name;
        item.style.display = name.includes(query) ? "block" : "none";
      });
    }

    function filterCategory(cat) {
      document.getElementById("searchInput").value = cat;
      filterProducts();
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
