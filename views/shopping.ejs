<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop Products</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/shopping", 
  navLinks: [
    { href: "/cart", label: "View Cart" },
    { href: "/orders", label: "My Orders" }
  ] 
}) %>

<!-- HERO -->
<div class="container page-shell">
  <div class="hero mb-4">
    <h1 class="hero-title">Shop our freshest picks</h1>
    <p class="hero-subtitle">Browse by category or search for what you need.</p>
    <div class="d-flex gap-2 flex-wrap mt-3">
      <a href="#products" class="btn btn-primary btn-sm">Start browsing</a>
      <a href="/cart" class="btn btn-light btn-sm">View cart</a>
    </div>
  </div>

  <!-- CAROUSEL -->
  <div id="heroCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/images/banner1.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner2.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner3.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
    </div>
  </div>

  <!-- Greeting -->
  <div class="section-heading">
    <div>
      <div class="section-title">Welcome back</div>
      <div class="section-subtitle"><%= user.username %> (<%= user.role %>)</div>
    </div>
  </div>

  <!-- SEARCH BAR -->
  <div class="glass mb-4">
    <form action="/shopping" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-8">
        <input 
          type="text" 
          class="form-control"
          placeholder="Search for products..."
          name="search"
          aria-label="Search for products"
          value="<%= typeof search !== 'undefined' ? search : '' %>"
        >
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-primary w-100">Search</button>
        <a href="/shopping" class="btn btn-light w-100">Clear</a>
      </div>
    </form>
  </div>

  <!-- CATEGORY FILTER -->
  <%
    const categories = [
      "All",
      "Fresh Produce",
      "Dairy & Eggs",
      "Meat & Seafood",
      "Bakery",
      "Beverages",
      "Snacks",
      "Frozen",
      "Household Essentials",
      "Baby & Kids",
      "Other"
    ];
  %>

  <div class="pill-nav mb-4">
    <% categories.forEach(c => { %>
      <a 
        href="/shopping<%= c !== 'All' ? ('?category=' + encodeURIComponent(c)) : '' %>" 
        class="btn btn-sm <%= (category === c) ? 'btn-primary' : 'btn-outline-primary' %>"
      >
        <%= c %>
      </a>
    <% }) %>
  </div>

  <!-- PRODUCT GRID -->
  <div id="products" class="row g-4">

    <% if (products.length === 0) { %>
      <div class="text-center mt-5">
        <h4 class="text-muted">No products found.</h4>
      </div>
    <% } %>

    <% products.forEach(p => { %>
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <div class="card product-card h-100 shadow-sm">

          <!-- Image -->
          <div class="ratio ratio-4x3 position-relative">
            <img 
              src="/images/<%= p.image %>"
              class="object-fit-cover rounded-top"
              alt="<%= p.productName %>"
            >
            <% if (p.quantity <= 0) { %>
              <span class="badge bg-danger position-absolute top-0 end-0 m-2">Out of Stock</span>
            <% } %>
          </div>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title">
              <a href="/product/<%= p.id %>" class="link-dark text-decoration-none">
                <%= p.productName %>
              </a>
            </h5>

            <span class="badge bg-secondary mb-1"><%= p.category %></span>

            <p class="text-muted small mb-1">Stock: <%= p.quantity %></p>
            <% const hasDiscount = p.discount && p.discount > 0; %>
            <% const finalPrice = hasDiscount ? p.price * (1 - p.discount / 100) : p.price; %>
            <p class="fw-bold h5 mb-1">$<%= finalPrice.toFixed(2) %></p>
            <% if (hasDiscount) { %>
              <p class="text-muted small mb-2 text-decoration-line-through">$<%= p.price.toFixed(2) %></p>
              <span class="badge bg-danger mb-2">-<%= p.discount %>%</span>
            <% } %>

            <% if (p.quantity > 0) { %>
              <!-- Add-to-Cart (only if stock) -->
              <form action="/add-to-cart/<%= p.id %>" method="POST" class="mt-auto">
                <div class="d-flex align-items-center mb-2">
                  <label class="text-muted small me-2 mb-0">Qty</label>

                  <select 
                    class="form-select form-select-sm me-2"
                    onchange="this.parentNode.querySelector('input').value = this.value;"
                  >
                    <% for (let q = 1; q <= Math.min(5, p.quantity); q++) { %>
                      <option value="<%= q %>"><%= q %></option>
                    <% } %>
                  </select>

                  <input type="hidden" name="quantity" value="1">
                </div>

                <button type="submit" class="btn btn-primary w-100">
                  Add to Cart
                </button>
              </form>
            <% } else { %>
              <div class="mt-auto">
                <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
              </div>
            <% } %>

          </div>
        </div>
      </div>
    <% }) %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
