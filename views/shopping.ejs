<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Shop - Supermarket App</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">

      <a class="navbar-brand fw-bold" href="/products">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/cart">View Cart</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/orders/history">My Orders</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>

        </ul>
      </div>

    </div>
  </nav>

  <!-- Page Container -->
  <div class="container py-4">

    <!-- Welcome Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <p class="text-muted small mb-0">Welcome back</p>
        <p class="fw-semibold mb-0"><%= user.username %> (<%= user.role %>)</p>
      </div>

      <div class="text-end">
        <span class="badge text-bg-primary">New Arrivals</span>
      </div>
    </div>

    <!-- Page Title -->
    <div class="text-center mb-4">
      <h2 class="mb-1">Fresh picks from our Supermarket</h2>
      <p class="text-muted">Browse, add to cart, and check out securely.</p>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
      <% products.forEach(product => { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">

          <div class="card product-card h-100 shadow-sm glass">

            <!-- Product Image -->
            <div class="ratio ratio-4x3">
              <img src="/images/<%= product.image %>" 
                   class="object-fit-cover rounded-top" 
                   alt="<%= product.productName %>">
            </div>

            <!-- Product Info -->
            <div class="card-body d-flex flex-column">

              <h5 class="card-title">
                <a href="/products/<%= product.id %>" 
                   class="link-dark text-decoration-none">
                  <%= product.productName %>
                </a>
              </h5>

              <p class="text-muted small mb-1">Stock: <%= product.quantity %></p>

              <p class="fw-bold h5">$<%= product.price.toFixed(2) %></p>

              <!-- Add to Cart -->
              <div class="mt-auto">

                <div class="d-flex align-items-center mb-2">
                  <label class="text-muted small me-2 mb-0">Qty</label>
                  <select class="form-select form-select-sm"
                          onchange="document.getElementById('qty-<%= product.id %>').value = this.value">
                    <% for (let q = 1; q <= Math.min(5, product.quantity); q++) { %>
                      <option value="<%= q %>"><%= q %></option>
                    <% } %>
                  </select>
                </div>

                <form action="/cart/add/<%= product.id %>" method="POST">
                  <input type="hidden" name="quantity" id="qty-<%= product.id %>" value="1">
                  <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                </form>

              </div>

            </div>
          </div>

        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>
