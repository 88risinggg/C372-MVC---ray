<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop Products</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-sm navbar-dark shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/shopping">Grow Mart</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/cart">View Cart</a></li>
        <li class="nav-item"><a class="nav-link" href="/orders">My Orders</a></li>
        <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO -->
<div class="container py-4">
  <div class="text-center mb-4">
    <h1 class="hero-title fw-bold">Welcome to Grow Mart!🛒</h1>
    <p class="hero-subtitle text-muted">Fresh deals, fast checkout.</p>
  </div>

  <!-- CAROUSEL -->
  <div id="heroCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/images/banner1.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner2.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
      <div class="carousel-item">
        <img src="/images/banner3.jpg" class="d-block w-100" style="height: 320px; object-fit: cover;">
      </div>
    </div>
  </div>



<div class="container py-4">

  <!-- Greeting -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <p class="text-muted small mb-0">Welcome back</p>
      <p class="fw-semibold mb-0"><%= user.username %> (<%= user.role %>)</p>
    </div>
  </div>

  <!-- SEARCH BAR -->
  <form action="/shopping" method="GET" class="input-group mb-4 shadow-sm">
    <input 
      type="text" 
      class="form-control" 
      placeholder="Search for products..." 
      name="search"
      value="<%= typeof search !== 'undefined' ? search : '' %>"
    >
    <button class="btn btn-primary">Search</button>
  </form>

  <!-- CATEGORY FILTER -->
  <%
    const categories = [
      "All",
      "Fresh Produce",
      "Dairy & Eggs",
      "Meat & Seafood",
      "Bakery",
      "Beverages",
      "Snacks",
      "Frozen",
      "Household Essentials",
      "Baby & Kids",
      "Other"
    ];
  %>

  <div class="d-flex flex-wrap gap-2 mb-4">
    <% categories.forEach(c => { %>
      <a 
        href="/shopping<%= c !== 'All' ? ('?category=' + encodeURIComponent(c)) : '' %>" 
        class="btn btn-sm <%= (category === c) ? 'btn-primary' : 'btn-outline-primary' %>"
      >
        <%= c %>
      </a>
    <% }) %>
  </div>

  <!-- PRODUCT GRID -->
  <div class="row g-4">

    <% if (products.length === 0) { %>
      <div class="text-center mt-5">
        <h4 class="text-muted">No products found.</h4>
      </div>
    <% } %>

    <% products.forEach(p => { %>
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <div class="card product-card h-100 shadow-sm">

          <!-- Image -->
          <div class="ratio ratio-4x3 position-relative">
            <img 
              src="/images/<%= p.image %>"
              class="object-fit-cover rounded-top"
              alt="<%= p.productName %>"
            >
            <% if (p.quantity <= 0) { %>
              <span class="badge bg-danger position-absolute top-0 end-0 m-2">Out of Stock</span>
            <% } %>
          </div>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title">
              <a href="/product/<%= p.id %>" class="link-dark text-decoration-none">
                <%= p.productName %>
              </a>
            </h5>

            <span class="badge bg-secondary mb-1"><%= p.category %></span>

            <p class="text-muted small mb-1">Stock: <%= p.quantity %></p>
            <% const hasDiscount = p.discount && p.discount > 0; %>
            <% const finalPrice = hasDiscount ? p.price * (1 - p.discount / 100) : p.price; %>
            <p class="fw-bold h5 mb-1">$<%= finalPrice.toFixed(2) %></p>
            <% if (hasDiscount) { %>
              <p class="text-muted small mb-2 text-decoration-line-through">$<%= p.price.toFixed(2) %></p>
              <span class="badge bg-danger mb-2">-<%= p.discount %>%</span>
            <% } %>

            <% if (p.quantity > 0) { %>
              <!-- Add-to-Cart (only if stock) -->
              <form action="/add-to-cart/<%= p.id %>" method="POST" class="mt-auto">
                <div class="d-flex align-items-center mb-2">
                  <label class="text-muted small me-2 mb-0">Qty</label>

                  <select 
                    class="form-select form-select-sm me-2"
                    onchange="this.parentNode.querySelector('input').value = this.value;"
                  >
                    <% for (let q = 1; q <= Math.min(5, p.quantity); q++) { %>
                      <option value="<%= q %>"><%= q %></option>
                    <% } %>
                  </select>

                  <input type="hidden" name="quantity" value="1">
                </div>

                <button type="submit" class="btn btn-primary w-100">
                  Add to Cart
                </button>
              </form>
            <% } else { %>
              <div class="mt-auto">
                <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
              </div>
            <% } %>

          </div>
        </div>
      </div>
    <% }) %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
