<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Edit Product</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">

      <a class="navbar-brand fw-bold" href="/products">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/products">Inventory</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/products/admin/add">Add Product</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>

        </ul>
      </div>

    </div>
  </nav>

  <!-- Main Page -->
  <div class="container py-4">

    <h2 class="text-center mb-4">Update Product</h2>

    <% if (product) { %>

      <form action="/products/admin/edit/<%= product.id %>"
            method="POST"
            enctype="multipart/form-data"
            class="mx-auto card p-4 glass"
            style="max-width: 550px;">

        <!-- Product Name -->
        <div class="mb-3">
          <label class="form-label">Product Name</label>
          <input type="text" class="form-control" name="name"
                 value="<%= product.productName %>" required>
        </div>

        <!-- Quantity -->
        <div class="mb-3">
          <label class="form-label">Quantity</label>
          <input type="number" class="form-control" name="quantity"
                 min="0" step="1"
                 value="<%= product.quantity %>" required>
        </div>

        <!-- Price -->
        <div class="mb-3">
          <label class="form-label">Price</label>
          <input type="number" class="form-control" name="price"
                 step="0.01" min="0"
                 value="<%= product.price %>" required>
        </div>


        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select class="form-select" id="category" name="category" required>
              <option value="Fruits" <%= product.category === 'Fruits' ? 'selected' : '' %>>Fruits</option>
              <option value="Snacks" <%= product.category === 'Snacks' ? 'selected' : '' %>>Snacks</option>
              <option value="Drinks" <%= product.category === 'Drinks' ? 'selected' : '' %>>Drinks</option>
              <option value="Household" <%= product.category === 'Household' ? 'selected' : '' %>>Household</option>
              <option value="Others" <%= product.category === 'Others' ? 'selected' : '' %>>Others</option>
          </select>
        </div>

        <!-- Current Image -->
        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <input type="text" class="form-control"
                 name="currentImage" value="<%= product.image %>" readonly>
          <img src="/images/<%= product.image %>"
               class="img-thumbnail mt-2"
               style="width: 150px;">
        </div>

        <!-- Upload New Image -->
        <div class="mb-4">
          <label class="form-label">Upload New Image</label>
          <input class="form-control" type="file"
                 name="image" accept="image/*">
        </div>

        <!-- Buttons -->
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">Update Product</button>
          <a href="/products" class="btn btn-secondary">Back to Inventory</a>
        </div>

      </form>

    <% } else { %>

      <p class="text-center text-danger">No product found.</p>

    <% } %>

  </div>

</body>
</html>
