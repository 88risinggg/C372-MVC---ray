<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link rel="stylesheet" href="/css/style.css">

  <title>Edit Product</title>
</head>

<body class="page">

<!-- Navbar -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/", 
  navLinks: [
    { href: "/inventory", label: "Inventory" },
    { href: "/products/admin/add", label: "Add Product" }
  ] 
}) %>


<div class="container py-4">

  <h2 class="text-center mb-4">Update Product</h2>

  <% if (product) { %>

    <form id="updateForm"
          action="/products/admin/edit/<%= product.id %>"
          method="POST"
          enctype="multipart/form-data"
          class="mx-auto form-box glass p-4"
          style="max-width: 550px;">

      <!-- Product Name -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Product Name</label>
        <input type="text" class="form-control" name="name" value="<%= product.productName %>" required>
      </div>

      <!-- Quantity -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Quantity</label>
        <input type="number" class="form-control" name="quantity" min="0" step="1" value="<%= product.quantity %>" required>
      </div>

      <!-- Price -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Price ($)</label>
        <input type="number" class="form-control" name="price" step="0.01" min="0" value="<%= product.price %>" required>
      </div>

      <!-- Discount -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Discount (%)</label>
        <input type="number" class="form-control" name="discount" min="0" max="100" step="0.01" value="<%= product.discount || 0 %>">
      </div>

      <!-- Category -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Category</label>
        <select class="form-select" name="category" required>
          <option value="Fresh Produce" <%= product.category === "Fresh Produce" ? "selected" : "" %>>Fresh Produce</option>
          <option value="Dairy & Eggs" <%= product.category === "Dairy & Eggs" ? "selected" : "" %>>Dairy & Eggs</option>
          <option value="Meat & Seafood" <%= product.category === "Meat & Seafood" ? "selected" : "" %>>Meat & Seafood</option>
          <option value="Bakery" <%= product.category === "Bakery" ? "selected" : "" %>>Bakery</option>
          <option value="Beverages" <%= product.category === "Beverages" ? "selected" : "" %>>Beverages</option>
          <option value="Snacks" <%= product.category === "Snacks" ? "selected" : "" %>>Snacks</option>
          <option value="Frozen" <%= product.category === "Frozen" ? "selected" : "" %>>Frozen</option>
          <option value="Household Essentials" <%= product.category === "Household Essentials" ? "selected" : "" %>>Household Essentials</option>
          <option value="Baby & Kids" <%= product.category === "Baby & Kids" ? "selected" : "" %>>Baby & Kids</option>
          <option value="Other" <%= product.category === "Other" ? "selected" : "" %>>Other</option>
        </select>
      </div>

      <!-- Current Image -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Current Image</label>
        <input type="text" class="form-control" name="currentImage" value="<%= product.image %>" readonly>
        <img src="/images/<%= product.image %>" class="img-thumbnail mt-2 shadow-sm" style="width: 150px; border-radius: 10px;">
      </div>

      <!-- New Image -->
      <div class="mb-4">
        <label class="form-label fw-semibold">Replace Image</label>
        <input type="file" class="form-control" name="image" accept="image/*">
      </div>

      <div class="d-grid gap-2">
        <button type="button" id="saveBtn" class="btn btn-primary">Save Changes</button>
        <a href="/inventory" class="btn btn-secondary">Back to Inventory</a>
      </div>

    </form>

  <% } else { %>
    <p class="text-center text-danger">Product not found.</p>
  <% } %>

</div>

<!-- SWEETALERT2 SCRIPT -->
<script>
document.getElementById("saveBtn").addEventListener("click", function () {
    Swal.fire({
        title: "Save changes?",
        text: "Are you sure you want to update this product?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, update",
        cancelButtonText: "Cancel",
        reverseButtons: true
    }).then((result) => {
        if (result.isConfirmed) {

            Swal.fire({
                title: "Updated!",
                text: "Product changes saved successfully.",
                icon: "success",
                showConfirmButton: false,
                timer: 1500
            });

            setTimeout(() => {
                document.getElementById("updateForm").submit();
            }, 1500);
        }
    });
});
</script>

</body>
</html>
