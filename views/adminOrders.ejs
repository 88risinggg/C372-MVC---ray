<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - All Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/", 
  navLinks: [
    { href: "/inventory", label: "Inventory" },
    { href: "/admin/orders", label: "Order History", active: true }
  ] 
}) %>

<div class="container page-shell">
  <div class="page-header reveal">
    <div>
      <p class="page-kicker">Admin</p>
      <h1 class="page-title">All User Orders</h1>
      <p class="page-subtitle">Monitor payments, totals, and fulfilment status.</p>
      <div class="page-meta mt-2">
        <span class="meta-pill"><%= orders.length %> orders</span>
      </div>
    </div>
  </div>

  <% const totalOrders = orders.length; %>
  <% const totalRevenue = (orders || []).reduce((sum, o) => sum + Number(o.total || 0), 0); %>
  <% const pendingCount = (orders || []).filter(o => o.orderStatus !== "Completed").length; %>

  <div class="triple-grid my-4 reveal">
    <div class="kpi-card">
      <div class="kpi-label">Total orders</div>
      <div class="kpi-value"><%= totalOrders %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Pending</div>
      <div class="kpi-value"><%= pendingCount %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Revenue</div>
      <div class="kpi-value">$<%= totalRevenue.toFixed(2) %></div>
    </div>
  </div>

  <div class="table-responsive glass p-3 reveal">
    <table class="table table-hover text-center align-middle">

      <thead class="table-light">
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Total ($)</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Refund</th>
          <th>Date</th>
          <th>View</th>
        </tr>
      </thead>

      <tbody>
        <% orders.forEach(order => { %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.username %></td>

          <!-- FIXED: Safe numeric formatting -->
          <td>$<%= Number(order.total).toFixed(2) %></td>

          <td><%= order.payment_method || "Unknown" %></td>

          <td>
            <span class="chip
              <%= order.orderStatus === 'Completed' ? 'success' :
                  (order.orderStatus === 'Out for delivery' || order.orderStatus === 'Delivering') ? 'info' :
                  'warn' %>">
              <%= order.orderStatus || "Preparing" %>
            </span>
          </td>

          <td>
            <span class="chip <%= order.refund_status === 'Refunded' ? 'danger' : 'info' %>">
              <%= order.refund_status || "Not refunded" %>
            </span>
          </td>

          <!-- FIXED: Convert SQL string into a readable date -->
          <td><%= new Date(order.created_at).toLocaleString() %></td>

          <td>
            <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>

    </table>
  </div>

</div>

<script src="/js/site.js"></script>`n</body>
</html>


