<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - All Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial", { 
  user, 
  brandHref: "/", 
  navLinks: [
    { href: "/inventory", label: "Inventory" },
    { href: "/admin/orders", label: "Order History", active: true }
  ] 
}) %>

<div class="container mt-4">

  <h2 class="mb-4">All User Orders</h2>

  <div class="table-responsive glass p-3">
    <table class="table table-hover text-center align-middle">

      <thead class="table-dark">
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Total ($)</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Date</th>
          <th>View</th>
        </tr>
      </thead>

      <tbody>
        <% orders.forEach(order => { %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.username %></td>

          <!-- FIXED: Safe numeric formatting -->
          <td>$<%= Number(order.total).toFixed(2) %></td>

          <td><%= order.paymentType %></td>

          <td>
            <span class="chip <%= order.status === 'Paid' ? 'success' : 'warn' %>"><%= order.status %></span>
          </td>

          <!-- FIXED: Convert SQL string into a readable date -->
          <td><%= new Date(order.created_at).toLocaleString() %></td>

          <td>
            <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>

    </table>
  </div>

</div>

</body>
</html>

