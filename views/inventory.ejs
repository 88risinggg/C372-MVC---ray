<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Inventory - Grow Mart</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial/navbar", { 
    user, 
    brandHref: "/", 
    navLinks: [
      { href: "/admin/orders", label: "Order History" },
      { href: "/products/admin/add", label: "Add Product" }
    ] 
  }) %>

  <!-- Main Container -->
  <div class="container mt-4">

    <!-- Welcome Text -->
    <p class="text-muted">
      Welcome, <strong><%= user.username %></strong> (<%= user.role %>)
    </p>

    <% if (outOfStock && outOfStock.length > 0) { %>
      <div class="alert alert-warning d-flex align-items-start gap-2">
        <div class="fw-semibold">Out of stock:</div>
        <div>
          <% outOfStock.forEach(item => { %>
            <span class="badge text-bg-warning text-dark me-1 mb-1"><%= item.productName %></span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="mb-0">Product Inventory</h2>

      <!-- Search Bar -->
      <form action="/inventory" method="GET" class="input-group" style="max-width: 280px;">
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Search products..."
               value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button class="btn btn-primary btn-sm">Go</button>
      </form>
    </div>

    <!-- Product Table -->
    <div class="table-responsive glass p-3">
      <table class="table table-hover align-middle text-center">

        <thead class="table-dark">
          <tr>
            <th width="150">Product</th>
            <th width="120">Image</th>
            <th width="100">Category</th>
            <th width="80">Stock</th>
            <th width="140">Price</th>
            <th width="70">Edit</th>
            <th width="70">Delete</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <!-- Product Name -->
              <td>
                <a href="/product/<%= product.id %>" class="text-decoration-none fw-semibold">
                  <%= product.productName %>
                </a>
              </td>

              <!-- Image -->
              <td>
                <img src="/images/<%= product.image %>" class="rounded shadow-sm" width="80">
              </td>

              <!-- Category -->
              <td>
                <span class="badge text-bg-primary"><%= product.category %></span>
              </td>

              <!-- Quantity -->
              <td><%= product.quantity %></td>

              <!-- Price -->
              <td>
                <% const hasDiscount = product.discount && product.discount > 0; %>
                <% const finalPrice = hasDiscount ? product.price * (1 - product.discount / 100) : product.price; %>
                <% if (hasDiscount) { %>
                  <div class="text-danger fw-semibold">$<%= finalPrice.toFixed(2) %></div>
                  <div class="text-muted small text-decoration-line-through mb-1">$<%= product.price.toFixed(2) %></div>
                  <span class="badge bg-danger">-<%= product.discount %>%</span>
                <% } else { %>
                  $<%= product.price.toFixed(2) %>
                <% } %>
              </td>

              <!-- Edit -->
              <td>
                <a href="/products/admin/edit/<%= product.id %>"
                   class="btn btn-sm btn-outline-primary">
                  Edit
                </a>
              </td>

              <!-- Delete -->
              <td>
                <a href="/products/admin/delete/<%= product.id %>"
                   class="btn btn-sm btn-outline-danger"
                   onclick="return confirm('Delete this product?');">
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    // Show success popup (add/delete product)
    <% if (success && success.length > 0) { %>
      Swal.fire({
        icon: "success",
        title: "Success",
        text: "<%= success[0] %>",
        confirmButtonColor: "#3085d6"
      });
    <% } %>
  </script>

</body>
</html>
