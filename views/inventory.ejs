<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Inventory - Supermarket App</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">

      <a class="navbar-brand fw-bold" href="/products">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/products/admin/add">Add Product</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="container mt-4">

    <!-- Welcome User Text -->
    <p class="text-muted">
      Welcome, <strong><%= user.username %></strong> (<%= user.role %>)
    </p>

    <h2 class="text-center mb-4">Product Inventory</h2>

    <!-- Product Table -->
    <div class="table-responsive">
      <table class="table table-hover table-bordered align-middle text-center bg-white">

        <thead class="table-dark">
          <tr>
            <th width="180">Product Name</th>
            <th width="150">Product Image</th>
            <th width="80">Quantity</th>
            <th width="80">Price</th>
            <th width="80">Edit</th>
            <th width="80">Delete</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <!-- Product Name -->
              <td>
                <a href="/products/view/<%= product.id %>" class="text-decoration-none fw-semibold">
                  <%= product.productName %>
                </a>
              </td>

              <!-- Image -->
              <td>
                <img src="/images/<%= product.image %>" 
                     class="rounded shadow-sm" width="90">
              </td>

              <!-- Quantity -->
              <td><%= product.quantity %></td>

              <!-- Price -->
              <td>$<%= product.price.toFixed(2) %></td>

              <!-- Edit -->
              <td>
                <a href="/products/admin/edit/<%= product.id %>" 
                   class="btn btn-sm btn-outline-primary">
                  Edit
                </a>
              </td>

              <!-- Delete -->
              <td>
                <a href="/products/admin/delete/<%= product.id %>" 
                   class="btn btn-sm btn-outline-danger"
                   onclick="return confirm('Are you sure you want to delete this product?');">
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  </div>

</body>
</html>
