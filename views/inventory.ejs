<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <title>Inventory - Grow Mart</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial/navbar", { 
    user, 
    brandHref: "/", 
    navLinks: [
      { href: "/admin/orders", label: "Order History" },
      { href: "/products/admin/add", label: "Add Product" }
    ] 
  }) %>

  <!-- Main Container -->
  <div class="container page-shell">
  <div class="page-header">
      <div>
        <p class="page-kicker">Admin</p>
        <h1 class="page-title">Product Inventory</h1>
        <p class="page-subtitle">Manage stock levels, pricing, and product details.</p>
        <div class="page-meta mt-2">
          <span class="meta-pill">Signed in as <span class="fw-semibold"><%= user.username %></span></span>
        </div>
      </div>
      <div class="page-actions">
        <form action="/inventory" method="GET" class="input-group">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search products..."
                 value="<%= typeof search !== 'undefined' ? search : '' %>">
          <button class="btn btn-primary btn-sm">Go</button>
        </form>
      </div>
    </div>

    <% const totalProducts = products.length; %>
    <% const outCount = outOfStock ? outOfStock.length : 0; %>
    <% const categoryCount = new Set(products.map(p => p.category)).size; %>

    <div class="triple-grid my-4 reveal">
      <div class="kpi-card">
        <div class="kpi-label">Total products</div>
        <div class="kpi-value"><%= totalProducts %></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Out of stock</div>
        <div class="kpi-value"><%= outCount %></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Categories</div>
        <div class="kpi-value"><%= categoryCount %></div>
      </div>
    </div>

    <% if (outOfStock && outOfStock.length > 0) { %>
      <div class="alert alert-warning d-flex align-items-start gap-2">
        <div class="fw-semibold">Out of stock:</div>
        <div>
          <% outOfStock.forEach(item => { %>
            <span class="badge text-bg-warning text-dark me-1 mb-1"><%= item.productName %></span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Product Table -->
    <div class="table-responsive glass p-3 reveal">
      <table class="table table-hover align-middle text-center">

      <thead class="table-light">
          <tr>
            <th width="150">Product</th>
            <th width="120">Image</th>
            <th width="100">Category</th>
            <th width="80">Stock</th>
            <th width="140">Price</th>
            <th width="70">Edit</th>
            <th width="70">Delete</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <!-- Product Name -->
              <td>
                <a href="/product/<%= product.id %>" class="text-decoration-none fw-semibold">
                  <%= product.productName %>
                </a>
              </td>

              <!-- Image -->
              <td>
                <img src="/images/<%= product.image %>" class="rounded shadow-sm" width="80">
              </td>

              <!-- Category -->
              <td>
                <span class="badge text-bg-primary"><%= product.category %></span>
              </td>

              <!-- Quantity -->
              <td><%= product.quantity %></td>

              <!-- Price -->
              <td>
                <% const hasDiscount = product.discount && product.discount > 0; %>
                <% const basePrice = Number(product.price || 0); %>
                <% const finalPrice = hasDiscount ? basePrice * (1 - product.discount / 100) : basePrice; %>
                <% if (hasDiscount) { %>
                  <div class="text-danger fw-semibold">$<%= finalPrice.toFixed(2) %></div>
                  <div class="text-muted small text-decoration-line-through mb-1">$<%= basePrice.toFixed(2) %></div>
                  <span class="badge bg-danger">-<%= product.discount %>%</span>
                <% } else { %>
                  $<%= basePrice.toFixed(2) %>
                <% } %>
              </td>

              <!-- Edit -->
              <td>
                <a href="/products/admin/edit/<%= product.id %>"
                   class="btn btn-sm btn-outline-primary">
                  Edit
                </a>
              </td>

              <!-- Delete -->
              <td>
                <a href="/products/admin/delete/<%= product.id %>"
                   class="btn btn-sm btn-outline-danger"
                   onclick="return confirm('Delete this product?');">
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (success && success.length > 0) { %>
    <script>
      Swal.fire({
        icon: "success",
        title: "Success",
        text: "<%= success[0] %>",
        confirmButtonColor: "#3085d6"
      });
    </script>
  <% } %>

<script src="/js/site.js"></script>`n</body>
</html>

