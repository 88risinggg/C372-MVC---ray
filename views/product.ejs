<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <title>Product Details</title>
</head>

<body class="page">

    <!-- Navbar -->
    <%- include("partial/navbar", { 
      user, 
      brandHref: "/shopping", 
      navLinks: (user && user.role === "admin")
        ? [
            { href: "/inventory", label: "Inventory" },
            { href: "/products/admin/add", label: "Add Product" }
          ]
        : [
            { href: "/shopping", label: "Shop" },
            { href: "/wallet", label: "Wallet" },
            { href: "/cart", label: "Cart" }
          ] 
    }) %>

    <!-- Main Content -->
    <div class="container page-shell">
        <div class="page-header">
            <div>
                <p class="page-kicker">Product</p>
                <h1 class="page-title"><%= product ? product.productName : "Product Details" %></h1>
                <p class="page-subtitle">Details, pricing, and stock information.</p>
                <div class="page-meta mt-2">
                    <span class="meta-pill">Signed in as <span class="fw-semibold"><%= user.username %></span></span>
                </div>
            </div>
        </div>

        <% if (product) { %>
            <% const hasDiscount = product.discount && product.discount > 0; %>
            <% const basePrice = Number(product.price || 0); %>
            <% const finalPrice = hasDiscount ? basePrice * (1 - product.discount / 100) : basePrice; %>
            <% const isAdmin = user && user.role === "admin"; %>

            <div class="row g-4 reveal">
                <div class="col-lg-6">
                    <div class="card glass h-100">
                        <div class="card-body text-center">
                            <img src="/images/<%= product.image %>" class="rounded shadow-sm mb-3" style="max-width: 360px;">
                            <% if (product.quantity <= 0) { %>
                                <div>
                                    <span class="badge bg-danger">Out of Stock</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card glass h-100">
                        <div class="card-body">
                            <h2 class="h4 mb-2"><%= product.productName %></h2>
                            <p class="text-muted">Freshly stocked and ready to ship.</p>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge badge-soft"><%= product.category %></span>
                                <span class="text-muted small">Stock: <%= product.quantity %></span>
                            </div>

                            <div class="mb-3">
                                <div class="fw-semibold">Price</div>
                                <div class="h4 fw-bold">$<%= finalPrice.toFixed(2) %></div>
                                <% if (hasDiscount) { %>
                                    <span class="text-muted text-decoration-line-through">$<%= basePrice.toFixed(2) %></span>
                                    <span class="badge bg-danger ms-2">-<%= product.discount %>%</span>
                                <% } %>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <a href="<%= isAdmin ? '/inventory' : '/shopping' %>" class="btn btn-outline-primary">
                                    <%= isAdmin ? 'Back to Inventory' : 'Continue Shopping' %>
                                </a>
                                <a href="/cart" class="btn btn-primary">View Cart</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <p class="text-danger text-center">No product found.</p>
        <% } %>

    </div>

<script src="/js/site.js"></script>`n</body>
</html>

