<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <title>Product Details</title>
</head>

<body class="page">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">

            <a class="navbar-brand fw-bold" href="/shopping">Grow Mart</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="collapsibleNavbar">
                <ul class="navbar-nav ms-auto">

                    <% if (user.role === "admin") { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/products">Inventory</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/products/admin/add">Add Product</a>
                        </li>
                    <% } %>

                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">

        <p class="text-muted">
            Welcome, <strong><%= user.username %></strong> (<%= user.role %>)
        </p>

        <h2 class="text-center mb-4">Product Details</h2>

        <% if (product) { %>

            <div class="card glass p-4 mx-auto" style="max-width: 500px;">

                <!-- Image -->
                <div class="text-center mb-3">
                    <img src="/images/<%= product.image %>"
                         class="rounded shadow-sm"
                         width="60%">
                    <% if (product.quantity <= 0) { %>
                        <div class="mt-2">
                            <span class="badge bg-danger">Out of Stock</span>
                        </div>
                    <% } %>
                </div>

                <!-- Details -->
                <p><b>Name:</b><br> <%= product.productName %></p>
                <p><b>Quantity:</b><br> <%= product.quantity %></p>
                <% const hasDiscount = product.discount && product.discount > 0; %>
                <% const finalPrice = hasDiscount ? product.price * (1 - product.discount / 100) : product.price; %>
                <p><b>Price:</b><br>
                  <span class="fw-semibold">$<%= finalPrice.toFixed(2) %></span>
                  <% if (hasDiscount) { %>
                    <span class="text-muted text-decoration-line-through ms-2">$<%= product.price.toFixed(2) %></span>
                    <span class="badge bg-danger ms-1">-<%= product.discount %>%</span>
                  <% } %>
                </p>

            </div>

        <% } else { %>

            <p class="text-danger text-center">No product found.</p>

        <% } %>

        <!-- Back Button -->
        <div class="text-center mt-4">
            <a href="/inventory" class="btn btn-primary">Back to Inventory</a>
        </div>

    </div>

</body>
</html>
