<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet - Grow Mart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<%- include("partial/navbar", { 
  user, 
  brandHref: "/shopping", 
  navLinks: [
    { href: "/shopping", label: "Shop" },
    { href: "/wallet", label: "Wallet", active: true },
    { href: "/cart", label: "Cart" },
    { href: "/orders", label: "My Orders" }
  ] 
}) %>

<div class="container page-shell">
  <div class="page-header">
    <div>
      <p class="page-kicker">Wallet</p>
      <h1 class="page-title">Your wallet balance</h1>
      <p class="page-subtitle">Top up and pay with your wallet at checkout.</p>
    </div>
  </div>

  <% if (errors && errors.length) { %>
    <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success"><%= success[0] %></div>
  <% } %>

  <div class="split-grid reveal">
    <div class="split-card">
      <h3 class="h5 mb-3">Balance</h3>
      <div class="display-6 fw-bold">$<%= Number(balance || 0).toFixed(2) %></div>
      <p class="text-muted mt-2 mb-3">Use your wallet at checkout for instant payment.</p>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-label">Status</div>
          <div class="stat-value">Active</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Tier</div>
          <div class="stat-value">Standard</div>
        </div>
      </div>
    </div>

    <div class="split-card">
      <h3 class="h5 mb-3">Top up wallet</h3>
      <form method="POST" action="/wallet/topup" class="row g-3" id="wallet-topup-form">
        <div class="col-md-7">
          <label class="form-label">Top-up amount (SGD)</label>
          <input type="number" step="0.01" min="1" class="form-control" name="amount" placeholder="e.g. 10.00" required>
        </div>
        <div class="col-md-5 d-flex align-items-end">
          <button type="submit" class="btn btn-primary w-100">Continue to Pay</button>
        </div>

        <div class="col-12">
          <div class="checkout-methods">
            <div class="checkout-methods__header">
              <div class="checkout-methods__icon" aria-hidden="true">$</div>
              <div>
                <p class="checkout-methods__kicker">Payment Method</p>
                <h3 class="checkout-methods__title">Choose how you'd like to top up</h3>
              </div>
            </div>

            <details class="method-accordion" open>
              <summary>E-wallets</summary>
              <div class="method-grid">
                <div class="method-option">
                  <input type="radio" name="paymentMethod" value="PayNow" aria-label="PayNow" id="wallet-pm-paynow">
                  <label class="method-pill method-pill--paynow" for="wallet-pm-paynow">
                    <span>PayNow</span>
                    <span class="method-pill__tag">QR</span>
                  </label>
                </div>
                <div class="method-option">
                  <input type="radio" name="paymentMethod" value="GrabPay" aria-label="GrabPay" id="wallet-pm-grabpay">
                  <label class="method-pill method-pill--grab" for="wallet-pm-grabpay">
                    <span>GrabPay</span>
                  </label>
                </div>
                <div class="method-option">
                  <input type="radio" name="paymentMethod" value="PayPal" aria-label="PayPal" id="wallet-pm-paypal">
                  <label class="method-pill method-pill--paypal" for="wallet-pm-paypal">
                    <span>PayPal</span>
                  </label>
                </div>
                <div class="method-option">
                  <input type="radio" name="paymentMethod" value="NETS QR" aria-label="NETS QR" id="wallet-pm-nets">
                  <label class="method-pill method-pill--nets" for="wallet-pm-nets">
                    <span>NETS QR</span>
                  </label>
                </div>
              </div>
            </details>

            <details class="method-accordion" open>
              <summary>Cards</summary>
              <div class="method-grid">
                <div class="method-option">
                  <input type="radio" name="paymentMethod" value="Stripe" aria-label="Stripe card" id="wallet-pm-stripe" checked>
                  <label class="method-pill method-pill--card" for="wallet-pm-stripe">
                    <span>Card</span>
                    <span class="method-pill__tag">Stripe</span>
                  </label>
                </div>
              </div>
            </details>
          </div>
        </div>

        <div class="col-12">
          <div id="wallet-stripe-section" class="split-card">
            <h6 class="fw-semibold mb-2">Card via Stripe</h6>
            <p class="small text-muted mb-0">You will be redirected to Stripe to complete payment securely.</p>
          </div>

          <div id="wallet-paypal-section" class="split-card d-none">
            <h6 class="fw-semibold mb-2">PayPal</h6>
            <p class="small text-muted mb-0">You will be redirected to PayPal to approve the payment.</p>
          </div>

          <div id="wallet-paynow-section" class="split-card d-none">
            <h6 class="fw-semibold mb-2">PayNow</h6>
            <p class="small text-muted mb-0">You will be redirected to Stripe to scan a PayNow QR and complete the top-up.</p>
          </div>

          <div id="wallet-grabpay-section" class="split-card d-none">
            <h6 class="fw-semibold mb-2">GrabPay</h6>
            <p class="small text-muted mb-0">You will be redirected to Stripe to authorize the GrabPay top-up.</p>
          </div>

          <div id="wallet-nets-section" class="split-card d-none">
            <h6 class="fw-semibold mb-2">NETS QR</h6>
            <p class="small text-muted mb-0">You will be redirected to a NETS QR page to scan and complete payment.</p>
          </div>
        </div>
      </form>
      <p class="small text-muted mt-3 mb-3">Top-ups are added after payment confirmation.</p>
      <div class="feature-grid">
        <div class="feature-card">
          <h4>Upgrade ready</h4>
          <p>Top up more to unlock perks.</p>
        </div>
        <div class="feature-card">
          <h4>Fast refunds</h4>
          <p>Wallet refunds arrive instantly.</p>
        </div>
        <div class="feature-card">
          <h4>Secure balance</h4>
          <p>Your wallet is protected.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const topupRadios = document.querySelectorAll('input[name="paymentMethod"]');
  const stripeSection = document.getElementById("wallet-stripe-section");
  const paypalSection = document.getElementById("wallet-paypal-section");
  const paynowSection = document.getElementById("wallet-paynow-section");
  const grabpaySection = document.getElementById("wallet-grabpay-section");
  const netsSection = document.getElementById("wallet-nets-section");

  const showTopupOnly = (section) => {
    [stripeSection, paypalSection, paynowSection, grabpaySection, netsSection].forEach(block => {
      if (!block) return;
      if (section && block === section) {
        block.classList.remove("d-none");
      } else {
        block.classList.add("d-none");
      }
    });
  };

  const updateTopupUI = () => {
    const selected = document.querySelector('input[name="paymentMethod"]:checked');
    switch (selected?.value) {
      case "PayPal":
        showTopupOnly(paypalSection);
        break;
      case "PayNow":
        showTopupOnly(paynowSection);
        break;
      case "GrabPay":
        showTopupOnly(grabpaySection);
        break;
      case "NETS QR":
        showTopupOnly(netsSection);
        break;
      case "Stripe":
      default:
        showTopupOnly(stripeSection);
    }
  };

  topupRadios.forEach(radio => radio.addEventListener("change", updateTopupUI));
  updateTopupUI();
</script>
<script src="/js/site.js"></script>
</body>
</html>

