<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet - Grow Mart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<%- include("partial/navbar", { 
  user, 
  brandHref: "/shopping", 
  navLinks: [
    { href: "/shopping", label: "Shop" },
    { href: "/wallet", label: "Wallet", active: true },
    { href: "/cart", label: "Cart" },
    { href: "/orders", label: "My Orders" }
  ] 
}) %>

<div class="container page-shell">
  <div class="page-header">
    <div>
      <p class="page-kicker">Wallet</p>
      <h1 class="page-title">Your wallet balance</h1>
      <p class="page-subtitle">Top up and pay with your wallet at checkout.</p>
    </div>
  </div>

  <% if (errors && errors.length) { %>
    <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success"><%= success[0] %></div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card glass shadow-sm h-100">
        <div class="card-body">
          <h3 class="h5 mb-3">Balance</h3>
          <div class="display-6 fw-bold">$<%= Number(balance || 0).toFixed(2) %></div>
          <p class="text-muted mt-2 mb-0">Use your wallet at checkout for instant payment.</p>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card glass shadow-sm">
        <div class="card-body">
          <h3 class="h5 mb-3">Top up wallet</h3>
          <form method="POST" action="/wallet/topup" class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Top-up amount (SGD)</label>
              <input type="number" step="0.01" min="1" class="form-control" name="amount" placeholder="e.g. 10.00" required>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">Top Up</button>
            </div>
          </form>
          <p class="small text-muted mt-3 mb-0">Top-ups are added immediately to your wallet balance.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
