<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">

  <title>Payment Successful</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial", { 
    user, 
    brandHref: "/shopping", 
    brandLabel: "Supermarket App", 
    navLinks: [
      { href: "/shopping", label: "Shop" },
      { href: "/orders", label: "My Orders" }
    ] 
  }) %>

  <!-- Main Content -->
  <div class="container py-5">

    <div class="card glass text-center p-4">

      <div class="display-6 mb-3">✅ Payment Successful</div>

      <p class="lead mb-2">Thank you, <%= user.username %>!</p>
      <p>Your simulated payment has been completed.</p>

      <h4 class="mb-3">
        Order ID: <span class="fw-bold"><%= orderId %></span>
      </h4>

      <div class="d-flex justify-content-center gap-3 mt-3">
        <a href="/orders/<%= orderId %>" class="btn btn-primary">
          View Order
        </a>

        <a href="/shopping" class="btn btn-outline-primary">
          Continue Shopping
        </a>
      </div>

    </div>

  </div>

</body>
</html>
