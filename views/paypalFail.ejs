<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PayPal Payment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="page">
  <%- include("partial/navbar", { 
    user, 
    brandHref: "/shopping", 
    navLinks: [
      { href: "/shopping", label: "Shop" },
      { href: "/wallet", label: "Wallet" },
      { href: "/orders", label: "My Orders" }
    ] 
  }) %>

  <div class="container page-shell">
    <section class="payment-hero payment-hero--single payment-hero--danger payment-success reveal">
      <div class="payment-hero-main">
        <div class="payment-icon" role="img" aria-label="Payment failed">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="4" fill="none"></circle>
            <path d="M22 22l20 20M42 22l-20 20" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
          </svg>
        </div>

        <p class="payment-kicker">Payment not completed</p>
        <h1 class="payment-title">We could not confirm your payment.</h1>
        <p class="payment-subtitle"><%= message %></p>

        <div class="action-row">
          <a href="/checkout" class="btn btn-primary btn-lg">Back to Checkout</a>
          <a href="/shopping" class="btn btn-outline-primary btn-lg">Continue Shopping</a>
        </div>
      </div>
    </section>
  </div>
<script src="/js/site.js"></script>
</body>
</html>


