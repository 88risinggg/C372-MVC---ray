<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">

  <title>Checkout</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial/navbar", { 
    user, 
    brandHref: "/shopping", 
    navLinks: [
      { href: "/shopping", label: "Shop" },
      { href: "/orders", label: "My Orders" }
    ] 
  }) %>

  <!-- Main Checkout Container -->
  <div class="container page-shell">
    <div class="page-header">
      <div>
        <p class="page-kicker">Checkout</p>
        <h1 class="page-title">Secure payment</h1>
        <p class="page-subtitle">Choose a payment method and place your order.</p>
        <div class="page-meta mt-2">
          <span class="meta-pill">Total <span class="fw-semibold">$<%= total.toFixed(2) %></span></span>
          <span class="meta-pill"><%= items.length %> items</span>
        </div>
      </div>
      <div class="page-actions">
        <a href="/cart" class="btn btn-outline-primary">Back to Cart</a>
      </div>
    </div>

    <div class="row g-4">

      <!-- Order Summary -->
      <div class="col-lg-5">
        <div class="card glass h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h3 class="h5 mb-0">Order Summary</h3>
            </div>
            <hr>

            <ul class="list-group list-group-flush mb-3">
              <% items.forEach(item => { %>
                <li class="list-group-item d-flex gap-3 align-items-center">
                  <% if (item.image) { %>
                    <img src="/images/<%= item.image %>" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
                  <% } %>
                  <div class="flex-grow-1">
                    <div class="fw-semibold"><%= item.productName %></div>
                    <small class="text-muted">Qty <%= item.quantity %></small>
                  </div>
                  <div class="fw-semibold">$<%= (item.price * item.quantity).toFixed(2) %></div>
                </li>
              <% }) %>
            </ul>

            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted">Subtotal</span>
              <span class="fw-semibold">$<%= subtotal.toFixed(2) %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted">Delivery Fee</span>
              <span class="fw-semibold">
                <% if (deliveryFee === 0) { %>
                  <span class="text-success">Free (orders above $50)</span>
                <% } else { %>
                  $<%= deliveryFee.toFixed(2) %>
                <% } %>
              </span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted">GST (9%)</span>
              <span class="fw-semibold">$<%= gst.toFixed(2) %></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold h5 mb-0">Total (incl. GST & delivery)</span>
              <span class="fw-bold h4 mb-0">$<%= total.toFixed(2) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Selection -->
      <div class="col-lg-7">
        <div class="card glass h-100 shadow-sm">
          <div class="card-body">
            <h2 class="h4 mb-3">Payment</h2>
            <p class="text-muted small mb-3">Choose a payment method and place your order.</p>

            <form id="checkout-form" method="POST" action="/checkout" class="row g-3">
              <% if (errors && errors.length) { %>
                <div class="alert alert-danger"><%= errors[0] %></div>
              <% } %>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="Stripe" aria-label="Stripe card" id="pm-stripe" checked>
                      <label class="form-check-label fw-semibold" for="pm-stripe">Card (Stripe)</label>
                      <p class="small text-muted mb-0">Pay securely by card via Stripe</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="Wallet" aria-label="Wallet" id="pm-wallet">
                      <label class="form-check-label fw-semibold" for="pm-wallet">Wallet</label>
                      <p class="small text-muted mb-0">Use your wallet balance to pay</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="PayPal" aria-label="PayPal" id="pm-paypal">
                      <label class="form-check-label fw-semibold" for="pm-paypal">PayPal</label>
                      <p class="small text-muted mb-0">Pay with your PayPal account</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="PayNow" aria-label="PayNow" id="pm-paynow">
                      <label class="form-check-label fw-semibold" for="pm-paynow">PayNow</label>
                      <p class="small text-muted mb-0">Instant bank transfer</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="GrabPay" aria-label="GrabPay" id="pm-grabpay">
                      <label class="form-check-label fw-semibold" for="pm-grabpay">GrabPay</label>
                      <p class="small text-muted mb-0">Pay with Grab wallet</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="NETS QR" aria-label="NETS QR" id="pm-nets">
                      <label class="form-check-label fw-semibold" for="pm-nets">NETS QR</label>
                      <p class="small text-muted mb-0">Scan with your banking or wallet app</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="Cash on Delivery" aria-label="Cash on Delivery" id="pm-cod">
                      <label class="form-check-label fw-semibold" for="pm-cod">Cash on Delivery</label>
                      <p class="small text-muted mb-0">Pay when you receive the order</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div id="stripe-section" class="card border-0 shadow-sm">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">Card via Stripe</h6>
                    <p class="small text-muted mb-0">You will be redirected to Stripe to complete payment securely.</p>
                  </div>
                </div>

                <div id="wallet-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">Wallet Balance</h6>
                    <p class="small text-muted mb-2">Current balance: <span class="fw-semibold">$<%= Number(walletBalance || 0).toFixed(2) %></span></p>
                    <p class="small text-muted mb-0">If your balance is low, top up in the Wallet page.</p>
                  </div>
                </div>

                <div id="paypal-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">PayPal</h6>
                    <p class="small text-muted mb-0">You will be redirected to PayPal to approve the payment.</p>
                  </div>
                </div>

                <div id="paynow-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">PayNow</h6>
                    <p class="small text-muted">Scan the QR code to transfer the total amount.</p>
                    <img src="/images/paynowqr.jpg" alt="PayNow QR" class="img-fluid rounded shadow-sm mb-3" style="max-width: 280px;">
                  </div>
                </div>

                <div id="grabpay-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">GrabPay</h6>
                    <p class="small text-muted">Scan with Grab to complete payment.</p>
                    <img src="/images/grabqr.jpg" alt="GrabPay QR" class="img-fluid rounded shadow-sm" style="max-width: 280px;">
                  </div>
                </div>

                <div id="nets-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">NETS QR</h6>
                    <p class="small text-muted mb-0">You will be redirected to a NETS QR page to scan and complete payment.</p>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="text-muted small">Secure checkout</div>
                  <div class="text-muted small">Encrypted payment</div>
                </div>
                <button type="submit" class="btn btn-success w-100 py-2">
                  Confirm Payment & Place Order
                </button>
              </div>
            </form>

          </div>
        </div>
      </div>

    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const methodRadios = document.querySelectorAll('input[name="paymentMethod"]');
    const stripeSection = document.getElementById("stripe-section");
    const walletSection = document.getElementById("wallet-section");
    const paypalSection = document.getElementById("paypal-section");
    const paynowSection = document.getElementById("paynow-section");
    const grabpaySection = document.getElementById("grabpay-section");
    const netsSection = document.getElementById("nets-section");

    const showOnly = (section) => {
      [stripeSection, walletSection, paypalSection, paynowSection, grabpaySection, netsSection].forEach(block => {
        if (!block) return;
        if (section && block === section) {
          block.classList.remove("d-none");
        } else {
          block.classList.add("d-none");
        }
      });
    };

    const updatePaymentUI = () => {
      const selected = document.querySelector('input[name="paymentMethod"]:checked');
      switch (selected?.value) {
        case "PayNow":
          showOnly(paynowSection);
          break;
        case "GrabPay":
          showOnly(grabpaySection);
          break;
        case "NETS QR":
          showOnly(netsSection);
          break;
        case "Cash on Delivery":
          showOnly(null);
          break;
        case "PayPal":
          showOnly(paypalSection);
          break;
        case "Wallet":
          showOnly(walletSection);
          break;
        case "Stripe":
        default:
          showOnly(stripeSection);
      }
    };

    methodRadios.forEach(radio => radio.addEventListener("change", updatePaymentUI));
    updatePaymentUI();
  </script>
</body>
</html>
