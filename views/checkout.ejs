<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">

  <title>Checkout</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/products">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/products">Shop</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/orders/history">My Orders</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Checkout Container -->
  <div class="container py-4">
    <div class="row g-4">

      <!-- Payment Selection -->
      <div class="col-lg-7">
        <div class="card glass">
          <div class="card-body">

            <h2 class="h4 mb-3">Select Payment Method</h2>

            <form method="POST" action="/orders/checkout" class="row g-3">

              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" value="Credit Card" checked>
                <label class="form-check-label">Credit Card (Simulated)</label>
              </div>

              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" value="PayNow">
                <label class="form-check-label">PayNow</label>
              </div>

              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" value="GrabPay">
                <label class="form-check-label">GrabPay</label>
              </div>

              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" value="Cash on Delivery">
                <label class="form-check-label">Cash on Delivery</label>
              </div>

              <div class="col-12 mt-3">
                <button type="submit" class="btn btn-success w-100">
                  Confirm Payment & Place Order
                </button>
              </div>
            </form>

          </div>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="col-lg-5">
        <div class="card glass">
          <div class="card-body">

            <h3 class="h5 mb-3">Order Summary</h3>

            <% let total = 0; %>

            <ul class="list-group list-group-flush mb-3">
              <% items.forEach(item => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <div class="fw-semibold"><%= item.productName %></div>
                    <small class="text-muted">Qty <%= item.quantity %></small>
                  </div>
                  <div>$<%= (item.price * item.quantity).toFixed(2) %></div>
                </li>
                <% total += item.price * item.quantity; %>
              <% }) %>
            </ul>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-semibold">Total</span>
              <span class="fw-bold h5 mb-0">$<%= total.toFixed(2) %></span>
            </div>

            <a href="/cart" class="btn btn-link ps-0">Back to Cart</a>

          </div>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
