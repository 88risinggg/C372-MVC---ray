<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">

  <title>Checkout</title>
</head>

<body class="page">

  <!-- Navbar -->
  <%- include("partial", { 
    user, 
    brandHref: "/shopping", 
    navLinks: [
      { href: "/shopping", label: "Shop" },
      { href: "/orders", label: "My Orders" }
    ] 
  }) %>

  <!-- Main Checkout Container -->
  <div class="container py-4">
    <div class="row g-4">

      <!-- Order Summary -->
      <div class="col-lg-5">
        <div class="card glass h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h3 class="h5 mb-0">Order Summary</h3>
              <a href="/cart" class="btn btn-link btn-sm">Back to Cart</a>
            </div>
            <hr>

            <ul class="list-group list-group-flush mb-3">
              <% items.forEach(item => { %>
                <li class="list-group-item d-flex gap-3 align-items-center">
                  <% if (item.image) { %>
                    <img src="/images/<%= item.image %>" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
                  <% } %>
                  <div class="flex-grow-1">
                    <div class="fw-semibold"><%= item.productName %></div>
                    <small class="text-muted">Qty <%= item.quantity %></small>
                  </div>
                  <div class="fw-semibold">$<%= (item.price * item.quantity).toFixed(2) %></div>
                </li>
              <% }) %>
            </ul>

            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted">Subtotal</span>
              <span class="fw-semibold">$<%= subtotal.toFixed(2) %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted">Delivery Fee</span>
              <span class="fw-semibold">
                <% if (deliveryFee === 0) { %>
                  <span class="text-success">Free (orders above $50)</span>
                <% } else { %>
                  $<%= deliveryFee.toFixed(2) %>
                <% } %>
              </span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted">GST (9%)</span>
              <span class="fw-semibold">$<%= gst.toFixed(2) %></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold h5 mb-0">Total (incl. GST & delivery)</span>
              <span class="fw-bold h4 mb-0">$<%= total.toFixed(2) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Selection -->
      <div class="col-lg-7">
        <div class="card glass h-100 shadow-sm">
          <div class="card-body">
            <h2 class="h4 mb-3">Payment</h2>
            <p class="text-muted small mb-3">Choose a payment method and place your order.</p>

            <form id="checkout-form" method="POST" action="/checkout" class="row g-3">
              <div id="payment-error" class="alert alert-warning d-none">Please fill in all card details to continue.</div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="Credit Card" aria-label="Credit card" id="pm-card" checked>
                      <label class="form-check-label fw-semibold" for="pm-card">Credit Card</label>
                      <p class="small text-muted mb-0">Visa / Master / Amex</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="PayNow" aria-label="PayNow" id="pm-paynow">
                      <label class="form-check-label fw-semibold" for="pm-paynow">PayNow</label>
                      <p class="small text-muted mb-0">Instant bank transfer</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="GrabPay" aria-label="GrabPay" id="pm-grabpay">
                      <label class="form-check-label fw-semibold" for="pm-grabpay">GrabPay</label>
                      <p class="small text-muted mb-0">Pay with Grab wallet</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="paymentMethod" value="Cash on Delivery" aria-label="Cash on Delivery" id="pm-cod">
                      <label class="form-check-label fw-semibold" for="pm-cod">Cash on Delivery</label>
                      <p class="small text-muted mb-0">Pay when you receive the order</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div id="card-section" class="card border-0 shadow-sm">
                  <div class="card-body">
                    <h6 class="fw-semibold mb-3">Card Details</h6>
                    <div class="mb-3">
                      <label class="form-label">Name on Card</label>
                      <input type="text" class="form-control card-required" name="cardName" placeholder="As shown on card">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Card Number</label>
                      <input type="text" class="form-control card-required" name="cardNumber" inputmode="numeric" maxlength="19" placeholder="1234 5678 9012 3456">
                    </div>
                    <div class="row g-3">
                      <div class="col-sm-6">
                        <label class="form-label">Expiry (MM/YY)</label>
                        <input type="text" class="form-control card-required" name="cardExpiry" placeholder="MM/YY">
                      </div>
                      <div class="col-sm-6">
                        <label class="form-label">CVV</label>
                        <input type="password" class="form-control card-required" name="cardCvv" maxlength="4" placeholder="***">
                      </div>
                    </div>
                  </div>
                </div>

                <div id="paynow-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">PayNow</h6>
                    <p class="small text-muted">Scan the QR code to transfer the total amount.</p>
                    <img src="/images/paynowqr.jpg" alt="PayNow QR" class="img-fluid rounded shadow-sm mb-3" style="max-width: 280px;">
                  </div>
                </div>

                <div id="grabpay-section" class="card border-0 shadow-sm d-none">
                  <div class="card-body text-center">
                    <h6 class="fw-semibold mb-3">GrabPay</h6>
                    <p class="small text-muted">Scan with Grab to complete payment.</p>
                    <img src="/images/grabqr.jpg" alt="GrabPay QR" class="img-fluid rounded shadow-sm" style="max-width: 280px;">
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="text-muted small d-flex align-items-center gap-1">
                    <span aria-hidden="true">🔒</span>
                    <span>Secure checkout</span>
                  </div>
                  <div class="text-muted small">Encrypted payment</div>
                </div>
                <button type="submit" class="btn btn-success w-100 py-2">
                  Confirm Payment & Place Order
                </button>
              </div>
            </form>

          </div>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const methodRadios = document.querySelectorAll('input[name="paymentMethod"]');
    const cardSection = document.getElementById("card-section");
    const paynowSection = document.getElementById("paynow-section");
    const grabpaySection = document.getElementById("grabpay-section");
    const form = document.getElementById("checkout-form");
    const cardFields = Array.from(document.querySelectorAll(".card-required"));
    const errorBox = document.getElementById("payment-error");

    const showOnly = (section) => {
      [cardSection, paynowSection, grabpaySection].forEach(block => {
        if (!block) return;
        if (section && block === section) {
          block.classList.remove("d-none");
        } else {
          block.classList.add("d-none");
        }
      });
    };

    const updatePaymentUI = () => {
      const selected = document.querySelector('input[name="paymentMethod"]:checked');
      const enableCard = selected?.value === "Credit Card";
      cardFields.forEach(f => {
        if (enableCard) {
          f.setAttribute("required", "required");
        } else {
          f.removeAttribute("required");
        }
      });
      if (!enableCard && errorBox) errorBox.classList.add("d-none");
      switch (selected?.value) {
        case "PayNow":
          showOnly(paynowSection);
          break;
        case "GrabPay":
          showOnly(grabpaySection);
          break;
        case "Cash on Delivery":
          showOnly(null);
          break;
        default: // Credit card or fallback
          showOnly(cardSection);
      }
    };

    methodRadios.forEach(radio => radio.addEventListener("change", updatePaymentUI));
    updatePaymentUI();

    if (form) {
      form.addEventListener("submit", (e) => {
        const selected = document.querySelector('input[name="paymentMethod"]:checked');
        if (selected?.value !== "Credit Card") return;
        const missing = cardFields.find(f => !f.value.trim());
        if (missing) {
          e.preventDefault();
          if (errorBox) errorBox.classList.remove("d-none");
          missing.focus();
        }
      });
    }
  </script>
</body>
</html>
