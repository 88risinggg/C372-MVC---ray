<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <title>Edit Product</title>
</head>

<body class="page">

    <!-- Navbar -->
    <%- include("partial/navbar", { 
      user, 
      brandHref: "/inventory", 
      navLinks: [
        { href: "/inventory", label: "Inventory" },
        { href: "/products/admin/add", label: "Add Product" }
      ] 
    }) %>

    <!-- Main Content -->
    <div class="container page-shell">
        <div class="page-header page-header--center mb-4">
            <p class="page-kicker">Inventory</p>
            <h1 class="page-title">Update Product</h1>
            <p class="page-subtitle">Edit details, pricing, and inventory.</p>
        </div>

        <% if (product) { %>
        <div class="auth-split reveal">
          <div class="auth-panel">
            <h2>Fine-tune the listing</h2>
            <p>Review pricing and stock levels before saving your updates.</p>
            <div class="hero-steps">
              <div class="hero-step">
                <span>1</span>
                <div>
                  <h3>Check pricing</h3>
                  <p>Update discounts when needed.</p>
                </div>
              </div>
              <div class="hero-step">
                <span>2</span>
                <div>
                  <h3>Validate stock</h3>
                  <p>Keep inventory accurate.</p>
                </div>
              </div>
              <div class="hero-step">
                <span>3</span>
                <div>
                  <h3>Refresh visuals</h3>
                  <p>Swap images for new campaigns.</p>
                </div>
              </div>
            </div>
          </div>

          <form action="/products/admin/edit/<%= product.id %>" 
                method="POST" enctype="multipart/form-data" 
                class="form-box">

            <!-- Product Name -->
            <div class="mb-3">
                <label for="productName" class="form-label">Product Name</label>
                <input type="text" class="form-control" id="productName" 
                       name="productName" value="<%= product.productName %>" required>
            </div>

            <!-- Quantity -->
            <div class="mb-3">
                <label for="quantity" class="form-label">Quantity</label>
                <input type="number" class="form-control" id="quantity" 
                       name="quantity" min="0" value="<%= product.quantity %>" required>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">Price ($)</label>
                <input type="number" class="form-control" id="price" 
                       name="price" min="0" step="0.01" value="<%= product.price %>" required>
            </div>

            <!-- Current Image -->
            <div class="mb-3">
                <label class="form-label">Current Image</label>
                <input type="text" class="form-control" value="<%= product.image %>" readonly>
                <img src="/images/<%= product.image %>" 
                     class="mt-2 rounded shadow-sm" width="40%">
            </div>

            <!-- Upload New Image -->
            <div class="mb-4">
                <label for="image" class="form-label">New Image (optional)</label>
                <input class="form-control" type="file" id="image" name="image" accept="image/*">
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100">Update Product</button>

          </form>
        </div>

        <% } else { %>
            <p class="text-center text-danger">Product not found.</p>
        <% } %>

        <div class="text-center mt-3">
            <a href="/products" class="btn btn-link">Back</a>
        </div>

    </div>

<script src="/js/site.js"></script>`n</body>
</html>

