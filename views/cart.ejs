<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="page">
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/shopping">Shop</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/orders">My Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <p class="text-muted mb-0 small">Signed in as</p>
        <p class="fw-semibold mb-0"><%= user.username %> (<%= user.role %>)</p>
      </div>
      <a href="/shopping" class="btn btn-outline-primary btn-sm">Continue Shopping</a>
    </div>

    <div class="card glass">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h4 mb-0">Shopping Cart</h2>
          <% if (cart.length) { %>
            <a class="btn btn-primary" href="/checkout">Proceed to Checkout</a>
          <% } %>
        </div>

        <% if (cart.length === 0) { %>
          <div class="empty-state">
            <p class="mb-0">Your cart is empty.</p>
            <a href="/shopping" class="btn btn-link ps-0">Browse products</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Product</th>
                  <th width="140">Price</th>
                  <th width="180">Quantity</th>
                  <th width="140">Total</th>
                  <th width="120"></th>
                </tr>
              </thead>
              <tbody>
                <% let total = 0; %>
                <% for (let i = 0; i < cart.length; i++) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <img src="/images/<%= cart[i].image %>" width="70" class="rounded me-3 shadow-sm" alt="<%= cart[i].productName %>">
                        <div>
                          <div class="fw-semibold"><%= cart[i].productName %></div>
                        </div>
                      </div>
                    </td>
                    <td>$<%= cart[i].price.toFixed(2) %></td>
                    <td>
                      <form class="d-flex align-items-center gap-2" action="/cart/update/<%= cart[i].id %>" method="POST">
                        <input type="number" class="form-control form-control-sm w-50" name="quantity" min="1" value="<%= cart[i].quantity %>">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Update</button>
                      </form>
                    </td>
                    <td>$<%= (cart[i].price * cart[i].quantity).toFixed(2) %></td>
                    <td>
                      <form action="/cart/remove/<%= cart[i].id %>" method="POST">
                        <button type="submit" class="btn btn-link text-danger btn-sm">Remove</button>
                      </form>
                    </td>
                  </tr>
                  <% total += cart[i].price * cart[i].quantity; %>
                <% }; %>
              </tbody>
            </table>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2">
            <h4 class="mb-0">Total: $<%= total.toFixed(2) %></h4>
            <a class="btn btn-primary" href="/checkout">Proceed to Checkout</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
