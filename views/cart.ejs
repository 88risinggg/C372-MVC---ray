<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="page">
  <%- include("partials/navbar", { 
    user, 
    brandHref: "/", 
    navLinks: [
      { href: "/shopping", label: "Shop" },
      { href: "/orders", label: "My Orders" }
    ] 
  }) %>

  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <p class="text-muted mb-0 small">Signed in as</p>
        <p class="fw-semibold mb-0"><%= user.username %> (<%= user.role %>)</p>
      </div>
      <a href="/shopping" class="btn btn-outline-primary btn-sm">Continue Shopping</a>
    </div>

    <div class="card glass">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h4 mb-0">Shopping Cart</h2>

          <% if (items.length) { %>
            <a class="btn btn-primary" href="/checkout">Proceed to Checkout</a>
          <% } %>
        </div>

        <% if (items.length === 0) { %>
          <div class="empty-state">
            <p class="mb-0">Your cart is empty.</p>
            <a href="/shopping" class="btn btn-link ps-0">Browse products</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Product</th>
                  <th width="140">Price</th>
                  <th width="180">Quantity</th>
                  <th width="140">Total</th>
                  <th width="120"></th>
                </tr>
              </thead>
              <tbody>
                <% let total = 0; %>
                <% for (let i = 0; i < items.length; i++) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <img src="/images/<%= items[i].image %>" width="70" class="rounded me-3 shadow-sm" alt="<%= items[i].productName %>">
                        <div>
                          <div class="fw-semibold"><%= items[i].productName %></div>
                        </div>
                      </div>
                    </td>

                    <td>$<%= items[i].price.toFixed(2) %></td>

                    <td>
                      <form class="d-flex align-items-center gap-2" action="/cart/update/<%= items[i].id %>" method="POST">
                        <input 
                          type="number" 
                          class="form-control form-control-sm w-50" 
                          name="quantity" 
                          min="1" 
                          value="<%= items[i].quantity %>"
                        >
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Update</button>
                      </form>
                    </td>

                    <td>$<%= (items[i].price * items[i].quantity).toFixed(2) %></td>

                    <td>
                      <form action="/cart/remove/<%= items[i].id %>" method="POST">
                        <button type="submit" class="btn btn-link text-danger btn-sm">Remove</button>
                      </form>
                    </td>
                  </tr>

                  <% total += items[i].price * items[i].quantity; %>
                <% } %>
              </tbody>
            </table>
          </div>

          <div class="d-flex align-items-center justify-content-between pt-2">
            <h4 class="mb-0">Total: $<%= total.toFixed(2) %></h4>
            <a class="btn btn-primary" href="/checkout">Proceed to Checkout</a>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</body>
</html>
