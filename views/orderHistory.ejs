<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">

  <title>Order History</title>
</head>

<body class="page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
    <div class="container-fluid">

      <a class="navbar-brand fw-bold" href="/shopping">Supermarket App</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/shopping">Shop</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/cart">Cart</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>

        </ul>
      </div>

    </div>
  </nav>

  <!-- Page Container -->
  <div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <p class="text-muted small mb-0">Order history for</p>
        <p class="fw-semibold mb-0"><%= user.username %></p>
      </div>

      <a href="/products" class="btn btn-outline-primary btn-sm">
        Keep Shopping
      </a>
    </div>

    <!-- Errors -->
    <% if (errors && errors.length) { %>
      <div class="alert alert-warning"><%= errors[0] %></div>
    <% } %>

    <!-- Order History Card -->
    <div class="card glass">
      <div class="card-body">

        <h2 class="h4 mb-3">Past Orders</h2>

        <% if (!orders || !orders.length) { %>

          <div class="empty-state text-center">
            <p class="mb-2">No orders yet.</p>
            <a href="/products" class="btn btn-link ps-0">
              Start Shopping
            </a>
          </div>

        <% } else { %>

          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Date</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>

              <tbody>
                <% orders.forEach(order => { %>
                  <tr>
                    <td>#<%= order.id %></td>

                    <td>
                      <%= new Date(order.created_at).toLocaleString() %>
                    </td>

                    <td>$<%= Number(order.total || 0).toFixed(2) %></td>

                    <td>
                      <span class="badge text-bg-success">Paid</span>
                    </td>

                    <td>
                      <a class="btn btn-sm btn-primary"
                         href="/orders/<%= order.id %>">
                        View
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>

            </table>
          </div>

        <% } %>

      </div>
    </div>

  </div>

</body>
</html>
