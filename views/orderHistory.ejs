<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order History - Grow Mart</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="page">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark shadow-sm">
  <div class="container-fluid">

    <a class="navbar-brand fw-bold" href="/shopping">Grow Mart</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
        <li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
        <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
      </ul>
    </div>

  </div>
</nav>


<div class="container py-4">

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <p class="text-muted small mb-0">Order history for</p>
      <p class="fw-semibold mb-0"><%= user.username %></p>
    </div>

    <a href="/shopping" class="btn btn-outline-primary btn-sm">Keep Shopping</a>
  </div>

  <!-- Errors -->
  <% if (errors && errors.length) { %>
    <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>

  <!-- Main Card -->
  <div class="card glass">
    <div class="card-body">

      <h2 class="h4 mb-3">Past Orders</h2>

      <% if (!orders || !orders.length) { %>

        <div class="text-center py-4">
          <p class="mb-2 text-muted">You haven’t placed any orders yet.</p>
          <a href="/shopping" class="btn btn-primary">Start Shopping</a>
        </div>

      <% } else { %>

        <div class="table-responsive">
          <table class="table align-middle">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>

            <tbody>
              <% orders.forEach(order => { %>
                <tr>
                  <td>#<%= order.id %></td>

                  <td><%= new Date(order.created_at).toLocaleString() %></td>

                  <td>$<%= Number(order.total).toFixed(2) %></td>

                  <td>
                    <span class="badge 
                      <%= order.orderStatus === 'Completed' ? 'bg-success' :
                          order.orderStatus === 'Delivering' ? 'bg-info' : 
                          'bg-warning' %>">
                      <%= order.orderStatus %>
                    </span>
                  </td>

                  <td>
                    <a href="/orders/<%= order.id %>" 
                       class="btn btn-sm btn-primary">
                      View
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>

          </table>
        </div>

      <% } %>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

