<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order History - Grow Mart</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/shopping", 
  navLinks: [
    { href: "/shopping", label: "Shop" },
    { href: "/cart", label: "Cart" }
  ] 
}) %>


<div class="container page-shell">
  <div class="page-header">
    <div>
      <p class="page-kicker">Orders</p>
      <h1 class="page-title">Order History</h1>
      <p class="page-subtitle">Review past orders and track their status.</p>
      <div class="page-meta mt-2">
        <span class="meta-pill">Customer <span class="fw-semibold"><%= user.username %></span></span>
      </div>
    </div>
    <div class="page-actions">
      <a href="/shopping" class="btn btn-outline-primary">Keep Shopping</a>
    </div>
  </div>

  <!-- Errors -->
  <% if (errors && errors.length) { %>
    <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>

  <!-- Main Card -->
  <div class="card glass">
    <div class="card-body">

      <h2 class="h4 mb-3">Past Orders</h2>

      <% if (!orders || !orders.length) { %>

        <div class="text-center py-4">
          <p class="mb-2 text-muted">You haven't placed any orders yet.</p>
          <a href="/shopping" class="btn btn-primary">Start Shopping</a>
        </div>

      <% } else { %>

        <div class="table-responsive">
          <table class="table align-middle">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Refund</th>
                <th></th>
              </tr>
            </thead>

            <tbody>
              <% orders.forEach(order => { %>
                <tr>
                  <td>#<%= order.id %></td>

                  <td><%= new Date(order.created_at).toLocaleString() %></td>

                  <td>$<%= Number(order.total).toFixed(2) %></td>

                  <td>
                    <span class="
                      status-badge
                      <%= order.orderStatus === 'Completed' ? 'status-completed' :
                          (order.orderStatus === 'Out for delivery' || order.orderStatus === 'Delivering') ? 'status-delivering' :
                          'status-preparing' %>">
                      <%= order.orderStatus || "Preparing" %>
                    </span>
                  </td>

                  <td>
                    <span class="
                      status-badge
                      <%= order.refund_status === 'Refunded' ? 'status-danger' : 'status-pending' %>">
                      <%= order.refund_status || "Not refunded" %>
                    </span>
                  </td>

                  <td>
                    <a href="/orders/<%= order.id %>" 
                       class="btn btn-sm btn-primary">
                      View
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>

          </table>
        </div>

      <% } %>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
