<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Order Details - Admin</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/", 
  navLinks: [
    { href: "/inventory", label: "Inventory" },
    { href: "/admin/orders", label: "Order History", active: true }
  ] 
}) %>

<div class="container page-shell">
  <div class="page-header reveal">
    <div>
      <p class="page-kicker">Admin</p>
      <h1 class="page-title">Order #<%= order.id %></h1>
      <p class="page-subtitle">Update fulfilment status and review order items.</p>
      <div class="page-meta mt-2">
        <span class="meta-pill">User <span class="fw-semibold"><%= order.username %></span></span>
        <span class="meta-pill">Payment <span class="fw-semibold"><%= order.payment_method || "Unknown" %></span></span>
      </div>
    </div>
    <div class="page-actions">
      <a href="/admin/orders" class="btn btn-outline-primary">Back to Orders</a>
    </div>
  </div>

  <% if (errors && errors.length) { %>
    <div class="alert alert-warning"><%= errors[0] %></div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success"><%= success[0] %></div>
  <% } %>

  <!-- Order Info Card -->
  <div class="card glass mb-4 reveal">
    <div class="card-body">
      <% const refundStatus = order.refund_status || "Not refunded"; %>
      <% const safeItems = items || []; %>
      <div class="section-grid">
        <div class="split-grid">
          <div class="panel-card">
            <h5 class="panel-title mb-3">Order Summary</h5>
            <div class="summary-grid">
              <div class="summary-item">
                <span class="summary-label">Order ID</span>
                <span class="summary-value">#<%= order.id %></span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Date</span>
                <span class="summary-value"><%= order.created_at.toLocaleString() %></span>
              </div>
              <div class="summary-item summary-item--wide">
                <span class="summary-label">Customer</span>
                <span class="summary-value"><%= order.username %> <span class="text-muted">(<%= order.email %>)</span></span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Payment</span>
                <span class="summary-value">
                  <span class="chip info"><%= order.payment_method || "Unknown" %></span>
                </span>
              </div>
            </div>
          </div>

          <div class="panel-card">
            <h5 class="panel-title mb-3">Status & Actions</h5>
            <div class="summary-grid summary-grid--single">
              <div class="summary-item">
                <span class="summary-label">Refund Status</span>
                <span class="summary-value">
                  <span class="chip <%= refundStatus === 'Approved' ? 'success' : refundStatus === 'Pending' ? 'warn' : refundStatus === 'Refunded' ? 'danger' : refundStatus === 'Rejected' ? 'danger' : 'info' %>">
                    <%= refundStatus %>
                  </span>
                </span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Order Status</span>
                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="d-flex flex-wrap gap-2 align-items-center">
                  <select name="orderStatus" class="form-select form-select-sm w-auto">
                    <option value="Preparing" <%= order.orderStatus === "Preparing" ? "selected" : "" %>>Preparing</option>
                    <option value="Out for delivery" <%= (order.orderStatus === "Out for delivery" || order.orderStatus === "Delivering") ? "selected" : "" %>>Out for delivery</option>
                    <option value="Completed" <%= order.orderStatus === "Completed" ? "selected" : "" %>>Completed</option>
                  </select>
                  <button class="btn btn-primary btn-sm">Update</button>
                </form>
              </div>
            </div>

            <% if (refundStatus === "Pending") { %>
              <div class="d-flex flex-wrap gap-2 mt-3">
                <form action="/admin/orders/<%= order.id %>/refund-approve" method="POST">
                  <button class="btn btn-outline-success btn-sm">Approve</button>
                </form>
                <form action="/admin/orders/<%= order.id %>/refund-reject" method="POST">
                  <button class="btn btn-outline-danger btn-sm">Reject</button>
                </form>
              </div>
            <% } else if (refundStatus === "Approved") { %>
              <form action="/admin/orders/<%= order.id %>/refund-complete" method="POST" class="mt-3">
                <button class="btn btn-outline-primary btn-sm">Mark Refunded</button>
              </form>
              <p class="text-muted small mt-2 mb-0">Approved. Please wait 3-5 working days.</p>
            <% } else if (refundStatus === "Rejected") { %>
              <p class="text-muted small mt-3 mb-0">Refund request rejected.</p>
            <% } else if (refundStatus === "Refunded") { %>
              <p class="text-muted small mt-3 mb-0">Refund completed.</p>
            <% } %>
          </div>
        </div>

        <div>
          <div class="section-heading">
            <h5 class="fw-semibold mb-0">Items</h5>
            <span class="text-muted small"><%= safeItems.length %> item(s)</span>
          </div>

          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead>
                <tr>
                  <th>Item</th>
                  <th class="text-center">Qty</th>
                  <th class="text-end">Unit</th>
                  <th class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                <% let total = 0; %>
                <% safeItems.forEach(item => { %>
                <% const unitPrice = Number(item.price) || 0; %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <img src="/images/<%= item.image %>" class="order-item-thumb shadow-sm" alt="<%= item.productName %>">
                      <div class="fw-semibold"><%= item.productName %></div>
                    </div>
                  </td>
                  <td class="text-center"><%= item.quantity %></td>
                  <td class="text-end">$<%= unitPrice.toFixed(2) %></td>
                  <td class="text-end fw-semibold">$<%= (unitPrice * item.quantity).toFixed(2) %></td>
                </tr>
                <% total += unitPrice * item.quantity; %>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-end mt-3">
            <div class="total-pill">
              <span>Total</span>
              <strong>$<%= total.toFixed(2) %></strong>
            </div>
          </div>

          <div class="text-end mt-3">
            <a href="/admin/orders" class="btn btn-secondary">Back to All Orders</a>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/site.js"></script>
</body>
</html>



