<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Order Details - Admin</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">

<!-- NAVBAR -->
<%- include("partial/navbar", { 
  user, 
  brandHref: "/", 
  navLinks: [
    { href: "/inventory", label: "Inventory" },
    { href: "/admin/orders", label: "Order History", active: true }
  ] 
}) %>

<div class="container py-4">

  <h2 class="fw-bold mb-4">Order Details (Admin)</h2>

  <!-- Order Info Card -->
  <div class="card glass mb-4">
    <div class="card-body">

      <div class="row">
        <div class="col-md-6">
          <p><strong>Order ID:</strong> <%= order.id %></p>
          <p><strong>User:</strong> <%= order.username %> (<%= order.email %>)</p>
        </div>

        <div class="col-md-6">

          <!-- Payment Status -->
          <p>
            <strong>Payment Status:</strong>
            <span class="chip <%= order.status === 'Paid' ? 'success' : 'warn' %>">
              <%= order.status %>
            </span>
          </p>

          <!-- Fulfilment Status -->
          <p><strong>Order Status:</strong></p>

          <form action="/admin/orders/<%= order.id %>/status" method="POST" class="d-flex gap-2 align-items-center">

            <select name="orderStatus" class="form-select form-select-sm w-auto">
              <option value="Preparing" <%= order.orderStatus === "Preparing" ? "selected" : "" %>>Preparing</option>
              <option value="Delivering" <%= order.orderStatus === "Delivering" ? "selected" : "" %>>Delivering</option>
              <option value="Completed" <%= order.orderStatus === "Completed" ? "selected" : "" %>>Completed</option>
            </select>

            <button class="btn btn-primary btn-sm">Update</button>
          </form>

          <p class="mt-3"><strong>Date:</strong> <%= order.created_at.toLocaleString() %></p>
        </div>
      </div>

      <hr>

      <h5 class="fw-semibold mb-3">Ordered Items</h5>

      <ul class="list-group">
        <% let total = 0; %>

        <% items.forEach(item => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">

          <div class="d-flex align-items-center">
            <img src="/images/<%= item.image %>" width="60" class="rounded me-3 shadow-sm">
            <div>
              <div class="fw-semibold"><%= item.productName %></div>
              <small class="text-muted">Qty: <%= item.quantity %></small>
            </div>
          </div>

          <div class="fw-semibold">
            $<%= (item.price * item.quantity).toFixed(2) %>
          </div>

        </li>
        <% total += item.price * item.quantity; %>
        <% }) %>
      </ul>

      <div class="mt-3 text-end">
        <h4>Total: $<%= total.toFixed(2) %></h4>
      </div>

      <div class="text-end mt-3">
        <a href="/admin/orders" class="btn btn-secondary">Back to All Orders</a>
      </div>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

